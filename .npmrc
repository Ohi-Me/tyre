# pnpm config (converted from Bun).
# shamefully-hoist gives a flatter node_modules like Bun/npm, which avoids
# "module not found" surprises with Next.js 16 + Tailwind 4 + Prisma in a workspace.
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
# Let Prisma's postinstall run.
enable-pre-post-scripts=true
