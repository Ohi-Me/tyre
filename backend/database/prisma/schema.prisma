// TYRE v3 — Prisma Schema
// AI Operating System for Emerging-Market Logistics
// Multi-region · Multi-currency · Multi-tenant · 100+ languages

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // For local dev, set DATABASE_URL="file:./db/tyre.db" and change provider to "sqlite"
  // (kept separate via the .env.dev example for convenience)
}

// ============================================================
// Enums (audit fix INFRA-C16)
// ------------------------------------------------------------
// Previously all status / role / tier fields were `String` with inline
// comments listing allowed values. No DB-level constraint, no type safety.
// These enums make the valid value set explicit at the DB and Prisma
// client boundary. Values mirror `backend/shared/constants/enums.ts`.
// ============================================================

enum UserRole {
  driver
  shipper
  broker
  fleet_manager
  operator
  admin
  super_admin
}

enum Region {
  IN
  BD
  PK
  NP
  LK
  NG
  KE
  GH
  ZA
  EG
  BR
  MX
  CO
  PE
  AE
  SA
  ID
  VN
  TH
  PH
}

enum LoadStatus {
  OPEN
  NEGOTIATING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TruckStatus {
  IDLE
  LOADING
  IN_TRANSIT
  UNLOADING
  MAINTENANCE
}

enum TripStatus {
