model UpiEscrowTransaction {
  id              String   @id @default(cuid())
  escrowAccountId String   @map("escrow_account_id")
  // Transaction
  transactionType TransactionType @map("transaction_type")  // FUNDING | ADVANCE_RELEASE | BALANCE_RELEASE | REFUND | TYRE_FEE
  amount          Float    // in INR
  // UPI details
  upiId           String?  @map("upi_id")
  upiTransactionRef String? @unique @map("upi_transaction_ref")
  razorpayTransferId String? @map("razorpay_transfer_id")
  /// Audit H3: the Razorpay `reference_id` (= our idempotency key) in a dedicated,
  /// indexed column. The webhook previously matched `upiTransactionRef CONTAINS
  /// reference_id` — an unindexed substring scan that silently missed rows whose
  /// ref was a synchronously-returned UTR. Webhooks + dedup now match this exactly.
  referenceId     String?  @map("reference_id")
  // Status
  status          TransactionStatus @default(PENDING)  // PENDING | SUCCESS | FAILED
  failureReason   String?  @map("failure_reason")
  // Trigger (what caused this transaction)
  triggerType     TriggerType @map("trigger_type")  // LOAD_ACCEPT | GPS_POD | CONSIGNEE_CONFIRM | CANCELLATION | ESCROW_FEE
  triggerRef      String?  @map("trigger_ref")  // trip_id, consignee_confirmation_id, etc.
  occurredAt      DateTime @default(now()) @map("occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt       DateTime?

  @@index([escrowAccountId, occurredAt])
  @@index([transactionType])
  @@index([status])
  @@index([referenceId])
  @@map("upi_escrow_transactions")
}

