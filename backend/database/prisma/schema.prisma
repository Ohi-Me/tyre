// ============================================================
// BroadcastLog — Week 3 of the WhatsApp↔Telegram bridge
// ------------------------------------------------------------
// When a broker broadcasts a load to nearby drivers, we log:
//   - which load (tyre_code) was broadcast
//   - which broker (broker_code) initiated it
//   - origin GPS + radius used for the nearby query
//   - how many drivers were found vs. notified (WhatsApp blasts can fail)
//   - the per-driver outcome (delivered / failed / opted-out)
//
// This is the audit trail required by the marketplace anti-spam rules:
// a broker can't broadcast the same load more than 3 times in 10 minutes,
// and a driver can't receive more than 5 broadcasts per hour. Both checks
// query this table.
// ============================================================
model BroadcastLog {
  id              String   @id @default(cuid())
  tyreCode        String   @map("tyre_code")
  brokerCode      String   @map("broker_code")
  // Origin snapshot — the load's origin coords at broadcast time. Stored
  // denormalized so the log row is self-contained even if the load is later
  // cancelled or edited.
  originLat       Float    @map("origin_lat")
  originLng       Float    @map("origin_lng")
  originLabel     String   @map("origin_label")   // human-readable, e.g. "Patna"
  radiusKm        Int      @map("radius_km")
  truckTypeFilter String?  @map("truck_type_filter")
  // Stats — updated atomically with the per-driver outcome list
  driversFound    Int      @default(0) @map("drivers_found")
  driversNotified Int      @default(0) @map("drivers_notified")
  driversFailed   Int      @default(0) @map("drivers_failed")
  // Per-driver outcome as a JSON array of {phone, name, distance_km, status}
  outcomes        String   @default("[]")
  initiatedBy     String   @default("broker_telegram") @map("initiated_by") // broker_telegram | dashboard | api
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tyreCode, createdAt])
  @@index([brokerCode, createdAt])
  @@index([createdAt])
  @@map("broadcast_logs")
}

// ============================================================
// Freight Marketplace — user-listed freight vehicles
// ------------------------------------------------------------
// A FreightListing is a vehicle + owner offered on the open
// marketplace. Anyone can search listings and request a booking;
// when the lister ACCEPTS a booking, a flat ₹49 platform fee is
// debited from the lister's payout ledger. If that booking is
// later CANCELLED, the ₹49 is refunded automatically. Every fee
// movement is an immutable FreightPayoutEntry row so the payout
// balance is always an auditable sum.
// ============================================================

enum FreightListingStatus {
  ACTIVE
  PAUSED
  BOOKED
}

enum FreightBookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum FreightPayoutType {
  BOOKING_FEE
  BOOKING_FEE_REFUND
}

model FreightListing {
  id            String   @id @default(cuid())
  code          String   @unique @map("code") // FRT-0001
  ownerId       String   @map("owner_id")     // device/session identity of the lister
  ownerName     String   @map("owner_name")
  phone         String
  photoUrl      String?  @map("photo_url")
  vehicleNumber String   @map("vehicle_number")
  vehicleType   String   @map("vehicle_type") // Open | Container | Tipper | Tanker | Refrigerated | Trailer
  capacityTons  Float    @map("capacity_tons")
  origin        String                         // home base / current location
  destination   String?                        // preferred route (optional)
  ratePerKm     Float?   @map("rate_per_km")
  expectedRate  Float?   @map("expected_rate") // flat expected rate for the route
  description   String   @default("")
  status        FreightListingStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")   // soft delete, consistent with Load/Truck

  bookings      FreightBooking[]
  payoutEntries FreightPayoutEntry[]

  @@index([status, vehicleType])
  @@index([ownerId])
  @@map("freight_listings")
}

model FreightBooking {
  id           String   @id @default(cuid())
  listingId    String   @map("listing_id")
  listing      FreightListing @relation(fields: [listingId], references: [id])
  bookerId     String   @map("booker_id")
  bookerName   String   @map("booker_name")
  bookerPhone  String   @map("booker_phone")
  pickup       String   @default("")
  dropoff      String   @default("")
  note         String   @default("")
  status       FreightBookingStatus @default(PENDING)
  // True once the ₹49 acceptance fee has been debited (and not yet refunded).
  // Guards against double-charging and double-refunding.
  feeCharged   Boolean  @default(false) @map("fee_charged")
  acceptedAt   DateTime? @map("accepted_at")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  payoutEntries FreightPayoutEntry[]

  @@index([listingId, status])
  @@index([bookerId])
  @@map("freight_bookings")
}

model FreightPayoutEntry {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")        // whose payout balance this affects
  listingId String?  @map("listing_id")
  listing   FreightListing? @relation(fields: [listingId], references: [id])
  bookingId String?  @map("booking_id")
  booking   FreightBooking? @relation(fields: [bookingId], references: [id])
  type      FreightPayoutType
  // Signed INR amount: BOOKING_FEE = -49, BOOKING_FEE_REFUND = +49
  amount    Float
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId, createdAt])
  @@map("freight_payout_entries")
}

/// Compliance document for a vehicle or driver (insurance, RC, permit, fitness,
/// pollution, licence, etc.). Status (VALID/EXPIRING/EXPIRED) is derived from
/// expiryDate at read time rather than stored. Scalar truck_id/driver_id (no FK
/// relation) so this model is fully additive and touches no existing model.
model Document {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  truckId    String?   @map("truck_id")
  driverId   String?   @map("driver_id")
  type       String    // INSURANCE | RC | PERMIT | FITNESS | POLLUTION | LICENSE | OTHER
  docNumber  String?   @map("doc_number")
  issuer     String?
  fileUrl    String?   @map("file_url")
  issueDate  DateTime? @map("issue_date")
  expiryDate DateTime? @map("expiry_date")
  notes      String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([orgId, expiryDate])
  @@index([truckId])
  @@index([driverId])
  @@map("documents")
}

/// Org tax identity (GSTIN/PAN/state) used by the settlement engine. Additive.
model TaxProfile {
  id            String   @id @default(cuid())
  orgId         String   @unique @map("org_id")
  legalName     String   @map("legal_name")
  gstin         String?
  pan           String?
  stateCode     String?  @map("state_code") // e.g. "BR", "DL"
  gstRegistered Boolean  @default(true) @map("gst_registered")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tax_profiles")
}

/// Immutable tax invoice + settlement for a completed trip (one per trip).
model Invoice {
  id               String    @id @default(cuid())
  invoiceNo        String    @unique @map("invoice_no")
  orgId            String    @map("org_id")
  tripId           String    @unique @map("trip_id")
  loadCode         String?   @map("load_code")
  placeOfSupply    String    @map("place_of_supply") // intra | inter
  currency         String    @default("INR")
  grossFreight     Float     @map("gross_freight")
  gstTotal         Float     @map("gst_total")
  commissionTotal  Float     @map("commission_total")
  tdsTotal         Float     @map("tds_total")
  invoiceTotal     Float     @map("invoice_total")
  carrierNetPayout Float     @map("carrier_net_payout")
  status           String    @default("ISSUED") // DRAFT | ISSUED | CANCELLED
  financialYear    String    @map("financial_year")
  pdfUrl           String?   @map("pdf_url")
  issuedAt         DateTime? @map("issued_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lines InvoiceLine[]

  @@index([orgId, financialYear, status])
  @@index([tripId])
  @@map("invoices")
}

/// One line of an invoice (freight, CGST/SGST/IGST, commission, commission GST, TDS).
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  kind        String
  description String
  amount      Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_lines")
}
