// ============================================================
// Identity & Multi-tenancy
// ============================================================

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  region          Region   @default(IN)
  defaultCurrency String   @default("INR") // ISO 4217
  defaultLocale   String   @default("en")
  plan            String   @default("free") // free | growth | enterprise
  gstin           String?  // India: GST identification
  taxId           String?  // Generic: tax identifier outside India
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt       DateTime?

  users  User[]
  loads  Load[]
  trips  Trip[]
  rfps   ShipperRFP[]
  trucks Truck[]

  @@map("organizations")
}

model User {
  id              String   @id @default(cuid())
  phone           String   @unique
  email           String?
  name            String
  passwordHash    String?  @map("password_hash")
  role            UserRole @default(driver) // driver | shipper | broker | fleet_manager | operator | admin | super_admin
  isActive        Boolean  @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  preferredLocale String   @default("en") @map("preferred_locale")
  region          Region   @default(IN)
  orgId           String   @map("org_id")
  org             Organization @relation(fields: [orgId], references: [id])
  kycVerified     Boolean  @default(false) @map("kyc_verified")
  upiId           String?  @map("upi_id")
  mobileMoneyId   String?  @map("mobile_money_id") // M-Pesa, MTN, etc.
  pixKey          String?  @map("pix_key") // Brazil
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt       DateTime?

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([orgId])
  @@map("users")
}

// ============================================================
// Auth — JWT access/refresh tokens, audit trail, service API keys
// Ported & adapted from the axle-platform (Express/Prisma) backend's
// auth subsystem during the TYRE 3-repo consolidation (see
// MERGE_REPORT.md). TYRE's web app authenticates browser sessions via
// NextAuth (phone-OTP, cookie/JWT session — see @tyre/auth/index.ts),
// while these models back a stateless bearer-token layer used by:
//   - apps/web/app/api/v1/auth/* REST endpoints (mobile clients, SSE
//     voice sessions that connect directly to apps/ai-gateway)
//   - service-to-service calls between the BFF and the AI gateway
// ============================================================

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") // SHA-256 of the opaque raw token; raw value is never stored
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "USER_LOGIN", "LOAD_ASSIGNED", "BROKER_BLOCKED", "ESCROW_RELEASED"
  entityType EntityType @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   String   @default("{}") // JSON
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt  DateTime?

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// NOTE: the canonical ApiKey model lives in the "ApiKey — Phase 0 fix" section
// near the end of this file. An earlier duplicate definition here was removed —
// Prisma rejects two models with the same name, which blocked `prisma generate`
// and the api_keys migration (see TYRE v1.1 item #2).

model Driver {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  preferredLang   String   @default("hi") @map("preferred_lang") // BCP-47
  truckType       String?  @map("truck_type")
  currentLocation String?  @map("current_location")
  // Week 3 broadcast: GPS coords for the nearby-driver query. Updated by the
  // voice pipeline when a driver shares location, or by periodic GPS pings.
  // Nullable so existing driver rows (and seed data) are unaffected. Indexed
  // via a composite index on (currentLat, currentLng, status) for the nearby
  // query path.
  currentLat      Float?   @map("current_lat")
  currentLng      Float?   @map("current_lng")
  currentRegion   Region   @default(IN) @map("current_region")
  status          DriverStatus @default(AVAILABLE) // AVAILABLE | ON_TRIP | OFFLINE
  rating          Float    @default(4.5)
  totalTrips      Int      @default(0) @map("total_trips")
  kycVerified     Boolean  @default(false) @map("kyc_verified")
  upiId           String?  @map("upi_id")
  mobileMoneyId   String?  @map("mobile_money_id")
  pixKey          String?  @map("pix_key")
  licenseNumber   String?  @map("license_number")
  createdAt       DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt       DateTime?

  trucks Truck[]

  @@index([status, currentLat, currentLng])
  @@map("drivers")
}

model Broker {
  id           String   @id @default(cuid())
  brokerCode   String   @unique @map("broker_code") // BRK-001
  name         String
  phone        String
  gstin        String?
  taxId        String?  @map("tax_id")
  region       Region   @default(IN)
  city         String?
  riskScore    Int      @default(0) @map("risk_score") // 0-100
  totalLoads   Int      @default(0) @map("total_loads")
  paymentDefaults Int   @default(0) @map("payment_defaults")
  verified     Boolean  @default(false)
  // Telegram bridge (Week 1): chat_id of the broker who linked via /link in
  // the @tyrebrokerbot. Null = not linked. Unique so two brokers can't share
  // one chat. Indexed for the broker bot's /loads lookup path
  // (GET /api/v1/brokers/by-telegram?chat_id=...).
  telegramChatId   String?  @unique @map("telegram_chat_id")
  telegramUsername String?  @map("telegram_username")
  telegramLinkedAt DateTime? @map("telegram_linked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt    DateTime?

  loads        Load[]
  fraudAlerts  FraudAlert[]

  @@index([telegramChatId])
  @@map("brokers")
}

// ============================================================
// Loads & Trips
// ============================================================

model Load {
  id              String   @id @default(cuid())
  tyreCode        String   @unique @map("tyre_code") // TYRE-0001
  orgId           String   @map("org_id")
  org             Organization @relation(fields: [orgId], references: [id])
  origin          String
  // Week 3 broadcast: origin GPS for the nearby-driver query. Nullable so
  // existing loads + seed data are unaffected; the broadcast service fails
  // gracefully with a clear "set origin GPS" message when missing.
  originLat       Float?   @map("origin_lat")
  originLng       Float?   @map("origin_lng")
  originRegion    Region   @default(IN) @map("origin_region")
  destination     String
  destinationLat  Float?   @map("destination_lat")
  destinationLng  Float?   @map("destination_lng")
  destinationRegion Region @default(IN) @map("destination_region")
  distanceKm      Int      @map("distance_km")
  weightTons      Float    @map("weight_tons")
  truckTypeReq    String   @map("truck_type_req")
  goodsType       String   @map("goods_type")
  offeredRate     Float    @map("offered_rate")
  aiSuggestedRate Float    @map("ai_suggested_rate")
  advanceOffered  Float    @map("advance_offered")
  currency        String   @default("INR") // ISO 4217
  status          LoadStatus @default(OPEN)
  riskLevel       RiskLevel @default(LOW)
  brokerId        String   @map("broker_id")
  broker          Broker   @relation(fields: [brokerId], references: [id])
  assignedTruckId String?  @map("assigned_truck_id")
  assignedTruck   Truck?   @relation(fields: [assignedTruckId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt       DateTime?

  negotiations Negotiation[]
  trips        Trip[]

  @@index([orgId, status])
  @@index([originRegion, destinationRegion])
  @@map("loads")
}

model Truck {
  id                       String   @id @default(cuid())
  orgId                    String   @map("org_id")
  org                      Organization @relation(fields: [orgId], references: [id])
  vehicleNumber            String   @unique @map("vehicle_number")
  truckType                String   @map("truck_type")
  driverId                 String?  @map("driver_id")
  driver                   Driver?  @relation(fields: [driverId], references: [id])
  currentLocation          String   @default("") @map("current_location")
  currentRegion            Region   @default(IN) @map("current_region")
  status                   TruckStatus @default(IDLE)
  utilizationPct           Int      @default(0) @map("utilization_pct")
  todaysKm                 Int      @default(0) @map("todays_km")
  totalKmThisMonth         Int      @default(0) @map("total_km_this_month")
  fuelEfficiencyKmpl       Float    @default(3.8) @map("fuel_efficiency_kmpl")
  nextMaintenanceKm        Int      @default(10000) @map("next_maintenance_km")
  lastMaintenanceDate      DateTime @default(now()) @map("last_maintenance_date")
  predictedBreakdownRisk   RiskLevel @default(LOW) @map("predicted_breakdown_risk")
  cargoLoaded              Boolean  @default(false) @map("cargo_loaded")
  destination              String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt                DateTime?

  loads Load[]
  trips Trip[]

  @@index([orgId, status])
  @@map("trucks")
}

model Trip {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  org          Organization @relation(fields: [orgId], references: [id])
  loadId       String   @unique @map("load_id")
  load         Load     @relation(fields: [loadId], references: [id])
  truckId      String   @map("truck_id")
  truck        Truck    @relation(fields: [truckId], references: [id])
  startTime    DateTime? @map("start_time")
  endTime      DateTime? @map("end_time")
  status       TripStatus @default(PLANNED)
  podVerified  Boolean  @default(false) @map("pod_verified")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  advanceAmount Float  @default(0) @map("advance_amount")
  balanceAmount Float  @default(0) @map("balance_amount")
  escrowRef    String? @map("escrow_ref") // UPI/Razorpay/Pix/M-Pesa escrow ref
  createdAt    DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt    DateTime?

  gpsPings GpsPing[]

  @@index([orgId, status])
  @@map("trips")
}

model GpsPing {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  trip      Trip     @relation(fields: [tripId], references: [id])
  lat       Float
  lng       Float
  speed     Float    @default(0) // km/h
  heading   Float    @default(0) // degrees
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tripId, createdAt])
  @@map("gps_pings")
}

// ============================================================
// Negotiation & Pricing
// ============================================================

model Negotiation {
  id           String   @id @default(cuid())
  loadId       String   @map("load_id")
  load         Load     @relation(fields: [loadId], references: [id])
  driverPhone  String   @map("driver_phone")
  driverLocale String   @default("hi") @map("driver_locale")
  brokerOffer  Float    @map("broker_offer")
  counterOffer Float    @map("counter_offer")
  finalRate    Float    @default(0) @map("final_rate")
  decision     NegotiationDecision // ACCEPTED | COUNTER | REJECTED
  rounds       Int      @default(1)
  messageHindi String?  @map("message_hindi") // original generated message
  messageTranslated String? @map("message_translated") // localized per driver_locale
  reasoning    String   @default("")
  aiConfidence Float    @default(0.9) @map("ai_confidence")
  createdAt    DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt    DateTime?

  @@index([loadId])
  @@map("negotiations")
}

model ShipperRFP {
  id                       String   @id @default(cuid())
  rfpCode                  String   @unique @map("rfp_code")
  orgId                    String   @map("org_id")
  org                      Organization @relation(fields: [orgId], references: [id])
  company                  String
  region                   Region   @default(IN)
  lanes                    Int      @default(1)
  monthlyVolumeTons        Int      @map("monthly_volume_tons")
  truckTypes               String   @map("truck_types") // JSON-encoded array
  expectedRatePerKm        Float    @map("expected_rate_per_km")
  currency                 String   @default("INR")
  contractDurationMonths   Int      @default(12) @map("contract_duration_months")
  status                   RfpStatus @default(SUBMITTED)
  submittedAt              DateTime @default(now()) @map("submitted_at")
  createdAt                DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt                DateTime?

  @@map("shipper_rfps")
}

// ============================================================
// Fraud & Compliance
// ============================================================

model FraudAlert {
  id         String   @id @default(cuid())
  brokerId   String   @map("broker_id")
  broker     Broker   @relation(fields: [brokerId], references: [id])
  riskScore  Int      @map("risk_score")
  flags      String   // JSON-encoded string array
  recommendation FraudRecommendation @default(MONITOR)
  status     FraudStatus @default(OPEN)
  detectedAt DateTime @default(now()) @map("detected_at")

  @@map("fraud_alerts")
}

model ComplianceDoc {
  id        String   @id @default(cuid())
  tripId    String?  @map("trip_id")
  docType   String   @map("doc_type") // e_way_bill | pod | invoice | cn | fastag_receipt
  docNumber String?  @map("doc_number") // gov-issued ID
  payload   String   // JSON
  region    Region   @default(IN)
  status    ComplianceDocStatus @default(PENDING) // PENDING | VERIFIED | REJECTED
  createdAt DateTime @default(now()) @map("created_at")

  @@map("compliance_docs")
}

// ============================================================
// AI Agents & Telemetry
// ============================================================

model AgentLog {
  id              String   @id @default(cuid())
  agentName       AgentName @map("agent_name")
  eventType       String   @map("event_type")
  payload         String   // JSON
  latencyMs       Int      @map("latency_ms")
  success         Boolean  @default(true)
  userLocale      String?  @map("user_locale") // BCP-47
  region          Region?  // IN | NG | ...
  createdAt       DateTime @default(now()) @map("created_at")
  /// Soft-delete marker (audit fix INFRA-C15)
  deletedAt       DateTime?

  @@index([agentName, createdAt])
  @@index([region, createdAt])
  @@map("agent_logs")
}

model FleetMetric {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id")
  date              String   @map("date") // YYYY-MM-DD
  region            Region   @default(IN)
  utilization       Int
  revenue           Int
  trips             Int
  emptyReturnPct    Int      @map("empty_return_pct")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([orgId, date, region])
  @@map("fleet_metrics")
}

model TranslationCache {
  id        String   @id @default(cuid())
  sourceText String  @map("source_text")
  sourceLang String  @map("source_lang") // BCP-47
  targetLang String  @map("target_lang")
  translatedText String @map("translated_text")
  transliteratedText String? @map("transliterated_text") // Latin version
  model     String   @default("nllb-200")
  confidence Float  @default(1.0)
  createdAt DateTime @default(now()) @map("created_at")
  lastAccessedAt DateTime @default(now()) @map("last_accessed_at")
  accessCount Int   @default(0) @map("access_count")

  @@unique([sourceText, sourceLang, targetLang, model])
  @@index([targetLang])
  @@index([lastAccessedAt])
  @@map("translation_cache")
}

// ============================================================
// Multilingual Content — every text-bearing entity has multilingual support
// ============================================================

model MultilingualContent {
  id        String   @id @default(cuid())
  // Polymorphic: links to any entity (Load.goods_type, Trip.notes, etc.)
  entityType EntityType @map("entity_type")   // load | trip | negotiation | broker | driver
  entityId   String @map("entity_id")
  field      String                          // e.g., "goods_type", "notes", "address"
  // Original content
  originalText   String @map("original_text")
  originalLang   String @map("original_lang") // BCP-47
  originalScript String @map("original_script") // Devanagari | Latin | Arabic | etc.
  // Translated content (JSON: { "hi": "...", "en": "...", "bho": "..." })
  translations Json    @default("{}")     // { locale: translated_text }
  // Transliterated content (JSON: { "hi-Latn": "...", "en-Deva": "..." })
  transliterations Json @default("{}")    // { locale_script: transliterated_text }
  // Voice metadata (if generated from voice input)
  voiceMetadata Json?                      // { audio_url, stt_provider, stt_confidence, detected_lang, duration_ms }
  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, field])
  @@index([entityType, entityId])
  @@index([originalLang])
  @@map("multilingual_content")
}

// ============================================================
// Conversation — cross-language conversation sync
// ============================================================

model Conversation {
  id        String   @id @default(cuid())
  // Optional references to business entities
  loadId    String?  @map("load_id")
  tripId    String?  @map("trip_id")
  // Participants: JSON array of {user_id, role, preferred_locale}
  participants Json                              // [{user_id, role, preferred_locale, voice_enabled}]
  status    ConversationStatus @default(ACTIVE)          // ACTIVE | CLOSED | ARCHIVED
  // Aggregated language stats
  primaryLanguage String @default("hi") @map("primary_language") // most common participant locale
  languagesUsed Json @default("[]")              // ["hi", "bho", "en"]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ConversationMessage[]

  @@index([loadId])
  @@index([tripId])
  @@map("conversations")
}

model ConversationMessage {
  id              String   @id @default(cuid())
  conversationId  String   @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Sender
  senderId        String   @map("sender_id")
  senderRole      String   @map("sender_role")          // driver | broker | shipper | operator
  senderName      String   @map("sender_name")
  senderLocale    String   @map("sender_locale")        // BCP-47
  // Original content (as spoken/typed by sender)
  originalText    String   @map("original_text")
  originalLocale  String   @map("original_locale")      // detected or self-declared
  originalAudioUrl String? @map("original_audio_url")   // S3 URL of sender's voice
  // Per-recipient localized versions (JSON)
  translations    Json     @default("{}")               // { locale: text }
  transliterations Json    @default("{}")               // { locale: latin_text }
  audioPerLocale  Json     @default("{}") @map("audio_per_locale") // { locale: audio_url }
  // NLU
  intent          VoiceIntent?
  confidence      Float    @default(1.0)
  // Audit
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

