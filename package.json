{
  "name": "tyre",
  "version": "3.0.0",
  "private": true,
  "description": "TYRE v3 \u2014 Stripe for emerging-market logistics. AI operating system for road freight across India, Africa, LatAm & MENA in 100+ languages.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:push": "pnpm --filter @tyre/db db:push",
    "db:generate": "pnpm --filter @tyre/db db:generate",
    "db:migrate": "pnpm --filter @tyre/db db:migrate",
    "seed": "tsx backend/database/seed/seed.ts",
    "i18n:translate": "tsx scripts/translate-messages.ts",
    "i18n:check": "tsx scripts/sync-locales.ts --check",
    "i18n:sync": "tsx scripts/sync-locales.ts",
    "regions:sync": "tsx scripts/sync-regions.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.18",
    "pnpm": ">=9"
  }
}
